APP_NAME="Khadamat Live LTD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://khadamat-live-backend.dev.com/

CURRENCY_CODE="AED"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bs_khadamat_live
